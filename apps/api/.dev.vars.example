# Biến môi trường local cho `wrangler dev` (KHÔNG commit .dev.vars thật — xem security.md).
# Copy file này thành .dev.vars rồi điền giá trị.

ENVIRONMENT="dev"

# U6 — Postgres qua Hyperdrive. Chuỗi kết nối local cho `wrangler dev` (Hyperdrive
# dùng biến này thay cho kết nối thật khi chạy local). CHỈ local, không commit:
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://user:pass@localhost:5432/vat"

# U6 — Khóa ký JWT nội bộ của SaaS (KHÔNG phải token thuế). Prod: `wrangler secret put JWT_SECRET`.
JWT_SECRET="doi-thanh-khoa-bi-mat-manh-cho-dev"

# U14 — KEK mã hóa token thuế tại nghỉ (base64 32 byte). Sinh: openssl rand -base64 32
# Local: đặt ở .dev.vars (đã .gitignore). Production: wrangler secret put TOKEN_KEK
TOKEN_KEK=REPLACE_WITH_BASE64_32BYTE_KEK

# U18 — Khóa ký token SUPER-ADMIN (Cổng Admin). BẮT BUỘC KHÁC JWT_SECRET: đây là lớp
# tách chính giữa miền khách và miền quản trị. Đặt trùng nhau thì mọi route /admin/*
# trả 503 (requireSuperAdmin fail-closed), không phải chạy tiếp với một lớp phòng thủ.
# Sinh: openssl rand -hex 32
# Prod: `wrangler secret put ADMIN_JWT_SECRET`
ADMIN_JWT_SECRET="doi-thanh-khoa-KHAC-jwt-secret-cho-dev"
