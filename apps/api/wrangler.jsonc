{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vat-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // CPU tối đa 5 phút (mặc định 30s) — nâng khi có step batch nặng.
  "limits": { "cpu_ms": 30000 }

  // --- Binding sẽ bật dần theo lộ trình (giữ comment ở U0) ---
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }],   // U4: Postgres
  // "kv_namespaces": [{ "binding": "SESSION", "id": "<KV_ID>" }],           // session/cấu hình
  // "r2_buckets": [{ "binding": "RAW", "bucket_name": "vat-raw" }],         // XML/PDF, kết xuất
  // "queues": { "producers": [{ "binding": "SYNC_QUEUE", "queue": "vat-sync" }] }, // U8: đồng bộ nền
  // "durable_objects": { "bindings": [{ "name": "TENANT_LIMITER", "class_name": "TenantLimiter" }] }
}
