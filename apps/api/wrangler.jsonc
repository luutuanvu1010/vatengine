{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vat-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  // Production: ẩn khỏi internet công cộng — chỉ gọi qua service binding từ front-door
  // `vat-web` (same-origin). Không lộ hostname `.workers.dev`.
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // CPU tối đa 5 phút (mặc định 30s) — nâng khi có step batch nặng.
  // TẮT trên Free (2026-07-14): Workers Free KHÔNG hỗ trợ đặt `limits` (deploy lỗi 100328).
  // Chạy với trần CPU mặc định Free 10ms/lần (I/O không tính). KHÔI PHỤC khi nâng Paid.
  // "limits": { "cpu_ms": 30000 },

  // U6: Postgres qua Hyperdrive. Thay "id" bằng id thật khi deploy
  // (`wrangler hyperdrive create`). Dev local: đặt WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // trong .dev.vars (KHÔNG commit chuỗi kết nối — security.md).
  // ⚠️ CACHE HYPERDRIVE PHẢI GIỮ TẮT — ĐỪNG BẬT LẠI.
  //
  // SỰ CỐ THẬT 2026-07-21 (production, U18): route admin diễn đạt mọi thao tác GHI dưới
  // dạng `SELECT ... FROM admin_*(...)` — vì chúng là hàm SECURITY DEFINER. Với bất kỳ lớp
  // nào phân tích SQL, những câu đó trông y hệt truy vấn ĐỌC, nên Hyperdrive cache chúng.
  // Hậu quả đo được: bấm "Duyệt" lần thứ hai trả 200 kèm mật khẩu tạm MỚI thay vì 409 —
  // tức chốt chặn TOCTOU của máy trạng thái bị vô hiệu, và mật khẩu vừa đọc cho khách chết
  // im lặng. Nhật ký ghi hai lần `duyet_tenant {cu:"cho_duyet"}` cách nhau 2 giây, trong
  // khi giữa hai lần đó khách đã đăng nhập được (tức tenant đang `active`).
  //
  // Đã tắt bằng: `wrangler hyperdrive update <id> --caching-disabled` (2026-07-21).
  // KIỂM CHỨNG sau khi tắt: cùng phép thử → lần 2 trả đúng 409; đọc danh sách khớp DB tức thì.
  //
  // Bật lại là lỗi quay về, ÂM THẦM. Và chi phí của việc tắt gần bằng 0: mọi truy vấn có
  // lưu lượng thật (hóa đơn/kết xuất/đối chiếu) đã chạy trong `withTenant` — tức trong
  // transaction — nên vốn KHÔNG được cache. Thứ duy nhất cache từng áp vào là đường quản
  // trị và `auth_lookup_user` ở /auth/login: đúng hai chỗ cần dữ liệu tươi nhất.
  //
  // Muốn bật lại thì trước đó phải bọc mọi lời gọi ghi vào `db.transaction(...)` và chứng
  // minh bằng phép thử "Duyệt hai lần → 409".
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "1011ff82e7154531883f0f2e62d344f0" }],

  // U7: R2 lưu file kết xuất (xlsx/csv). Tạo bucket lúc deploy:
  // `wrangler r2 bucket create vat-raw`. Dev local: Miniflare mô phỏng R2 tự động.
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "vat-raw" }],

  // Nhãn môi trường (KHÔNG nhạy cảm) — /health báo env, phân nhánh hành vi nếu cần.
  // H-A.5a — PBKDF2_ITERATIONS: số vòng băm mật khẩu SaaS cho hash MỚI. GIỮ 100000 trên
  // Free (đo: 600k ~42ms > trần CPU Free 10ms). ĐỔI "600000" (OWASP) SAU khi nâng Paid
  // (H-A.3). Không nhạy cảm; hash tự mô tả số vòng nên đổi không phá hàng cũ.
  "vars": { "ENVIRONMENT": "production", "PBKDF2_ITERATIONS": "100000" },

  // "Đồng bộ ngay" (POST /tax-accounts/:id/sync) đẩy job vào hàng đợi vat-sync;
  // consumer là apps/sync-worker. API chỉ là PRODUCER (giữ stateless — ADR-0001 §3).
  "queues": { "producers": [{ "binding": "SYNC_QUEUE", "queue": "vat-sync" }] },

  // H-A.5b — Durable Object khóa đăng nhập per-account (lockout chống brute-force, lớp
  // app bổ sung WAF per-IP ở edge). Trạng thái nhỏ theo email → SQLite-backed DO.
  // H-A.5b — DO khóa đăng nhập; U22 — DO BackfillTracker (1 DO / backfillId, giữ danh
  // sách tháng của một backfill; trạng thái nhỏ → SQLite-backed DO). U17b (QĐ-2) — DO
  // SignupLimiter đếm lượt đăng ký công khai theo IP (trạng thái nhỏ → SQLite-backed DO).
  "durable_objects": {
    "bindings": [
      { "name": "LOGIN_LIMITER", "class_name": "LoginLimiter" },
      { "name": "BACKFILL_TRACKER", "class_name": "BackfillTracker" },
      { "name": "SIGNUP_LIMITER", "class_name": "SignupLimiter" }
    ]
  },
  // KHÔI PHỤC sau sự cố 2026-07-16: một phiên deploy nhầm code cũ (thiếu H-A.5b) rồi áp
  // delete-class (v2) → DO LoginLimiter đang chạy bị xoá. Worker LIVE đã áp v1+v2. Thêm v3
  // tạo lại class (SQLite namespace mới, chỉ mất bộ đếm lockout tạm). GIỮ nguyên v1/v2 theo
  // thứ tự (Cloudflare legacy migrations = lịch sử cộng dồn, không sửa tag cũ). v4 (U22):
  // THÊM class mới BackfillTracker — thuần cộng dồn, KHÔNG đụng tag cũ (an toàn, khác v2).
  // v5 (U17b QĐ-2): THÊM class mới SignupLimiter — cũng thuần cộng dồn, KHÔNG đụng tag cũ.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LoginLimiter"] },
    { "tag": "v2", "deleted_classes": ["LoginLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["LoginLimiter"] },
    { "tag": "v4", "new_sqlite_classes": ["BackfillTracker"] },
    { "tag": "v5", "new_sqlite_classes": ["SignupLimiter"] }
  ]

  // H-A.5b — ngưỡng khóa đăng nhập (KHÔNG nhạy cảm; bỏ trống → mặc định loginLimiter.ts:
  // 10 lần sai / 15' → khóa 15'). Tinh chỉnh theo môi trường.
  // "vars" thêm: LOGIN_MAX_FAILURES / LOGIN_WINDOW_MS / LOGIN_LOCKOUT_MS.

  // --- Binding sẽ bật dần theo lộ trình (giữ comment) ---
  // "kv_namespaces": [{ "binding": "SESSION", "id": "<KV_ID>" }],           // session/cấu hình
  //
  // U9 (đồng bộ nền: Cron + Queues + Durable Object TENANT_LIMITER) nằm ở WORKER RIÊNG
  // `apps/sync-worker` — KHÔNG gộp vào API stateless này. Xem apps/sync-worker/wrangler.jsonc.
  //
  // JWT_SECRET (khóa ký JWT nội bộ) nạp qua `wrangler secret put JWT_SECRET` — security.md.
  //
  // U18 — ADMIN_JWT_SECRET (khóa ký token super-admin) nạp qua
  // `wrangler secret put ADMIN_JWT_SECRET`. PHẢI KHÁC JWT_SECRET: trùng nhau ⇒ hai miền
  // token gộp làm một và requireSuperAdmin trả 503 cho toàn bộ /admin/* (fail-closed,
  // có test). Không khai ở "vars" — đây là bí mật (security.md).
}
