{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vat-sync-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // BẢO MẬT (H-B.6): worker này chạy bằng Cron + Queue, KHÔNG cần URL công khai. Endpoint
  // quản trị `POST /dlq/replay` (phát lại job DLQ) phải sau Cloudflare Access (security.md
  // "khu quản trị dùng Cloudflare Access"). TẮT `*.workers.dev` (giống vat-api) + đưa lên
  // hostname trong zone tourdao.vn để Access chặn được (Access không bảo vệ *.workers.dev).
  // Bật Access cho `vat-sync-admin.tourdao.vn/dlq/*` NGAY sau deploy — trước đó endpoint
  // vẫn công khai ở hostname này (blast-radius thấp: ép tenantId + RLS, chỉ replay job hỏng).
  "workers_dev": false,
  "routes": [{ "pattern": "vat-sync-admin.tourdao.vn", "custom_domain": true }],

  // Job đồng bộ nền có thể chạy dài (phân trang nhiều kỳ) — nâng trần CPU.
  // Cron wall-time 15' / CPU 15' nếu chu kỳ ≥ 1h (ADR-0001 §3).
  // BẬT LẠI 2026-07-18: chủ dự án đã nâng **Workers Paid**, đúng điều kiện mà ghi chú
  // cũ đặt ra ("KHÔI PHỤC cpu_ms khi nâng Paid"). Trước đó TẮT vì Free không hỗ trợ
  // đặt `limits` (deploy lỗi 100328) và chạy với trần mặc định 10ms/lần.
  // GIẢ THUYẾT (chưa kiểm chứng): trần CPU mặc định của Free là nguồn của
  // "The operation was aborted" (n=43) trong sự cố 2026-07-18 — theo dõi sau deploy.
  // Nếu deploy trả lỗi 100328 ⇒ gói Paid CHƯA hiệu lực, revert dòng này.
  "limits": { "cpu_ms": 300000 },

  // Cron:
  //  - "0 3 * * *" (03:00 UTC = 10:00 VN): phát tán job đồng bộ — liệt kê account
  //    token còn hạn → enqueue; giãn tải, tôn trọng máy chủ thuế.
  //  - "*/15 * * * *" (mỗi 15'): GIÁM SÁT (mục C) — probe egress T0; verdict xấu ổn
  //    định (3 tick liên tiếp) → cảnh báo qua Workers observability. scheduled() phân
  //    nhánh theo event.cron. KHÔNG bật T1 (đang TREO) — chỉ phát hiện + cảnh báo.
  "triggers": { "crons": ["0 3 * * *", "*/15 * * * *"] },

  // Postgres qua Hyperdrive (giống apps/api). Thay "id" bằng id thật khi deploy.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "1011ff82e7154531883f0f2e62d344f0" }],

  // Hàng đợi job đồng bộ: worker này VỪA là producer (scheduled() enqueue) VỪA là
  // consumer (queue() xử lý). Tạo lúc deploy: `wrangler queues create vat-sync`.
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "vat-sync" }],
    "consumers": [
      {
        "queue": "vat-sync",
        // Retry lỗi tạm (transient) — chốt chặn: sau max_retries → dead-letter.
        // (H-B.4: backpressure rate_limited/breaker_open KHÔNG dùng đường này — được
        // reenqueue message mới có delay ở consumer nên KHÔNG tính vào max_retries.)
        "max_retries": 5,
        // SỰ CỐ 2026-07-18 — hạ 10 → 5. Ngân sách subrequest của Workers tính theo
        // INVOCATION, không theo message: một lô 10 message header (mỗi message phân
        // trang GDT + ghi DB + gọi DO limiter) vượt trần 50/invocation của gói Free →
        // `lan_dong_bo` ghi n=61 "Too many subrequests by single Worker invocation"
        // (bằng chứng: production 05:30–06:15Z 2026-07-18), kéo theo mở circuit
        // breaker và chặn toàn bộ đồng bộ.
        //
        // Chủ dự án đã nâng **Workers Paid** (2026-07-18) ⇒ trần thành 1000/invocation
        // (gấp 20×), nên nguyên nhân cấp tính đã được gỡ ở tầng gói. Vẫn KHÔNG quay
        // lại 10 ngay: vừa có sự cố thật, chọn 5 để còn biên an toàn ~2.5× cho tenant
        // nhiều hóa đơn, đồng thời giữ thông lượng cao hơn hẳn mức 1. Có thể nâng lại
        // 10 sau khi quan sát vài chu kỳ sạch.
        //
        // ĐÃ KIỂM CHỨNG tiên lượng trên: 2026-07-18 14:05–14:11Z (SAU khi lên Paid),
        // batch 5 lại ra "Too many subrequests" ×4 trong `lan_dong_bo` — job tháng lớn
        // (~100+ trang × retry 429 lên tới 3 lượt/trang + DB + DO) cộng dồn theo
        // INVOCATION. Hạ 5 → 1: một job/invocation, tối đa ~200–400 subrequest, dưới
        // trần Paid. Đánh đổi thông lượng chấp nhận được (max_concurrency vẫn 3).
        // Fix bền: chia job theo TRANG (chunk kỳ) — BACKLOG 2026-07-18.
        "max_batch_size": 1,
        // H-B.4 — GIỚI HẠN đồng thời consumer: chặn bùng nổ invocation làm cạn pool
        // Hyperdrive/dồn dập GDT. Giá trị THẬN TRỌNG mặc định; tinh chỉnh trên staging
        // theo tải thật (H-A.4 tách Hyperdrive + H-B.5 sharding). CHƯA KIỂM CHỨNG số
        // tối ưu — đây là trần an toàn, không phải cam kết hiệu năng.
        "max_concurrency": 3,
        "dead_letter_queue": "vat-sync-dlq"
      },
      // H-B.6 — consumer riêng cho queue dead-letter: ghi sổ dong_bo_that_bai + audit
      // CRITICAL (dlqConsume) rồi ack. KHÔNG khai dead_letter_queue ở đây (tránh
      // DLQ-của-DLQ vô hạn) — max_retries:3 là chốt chặn cuối, lỗi vượt trần bị bỏ.
      {
        "queue": "vat-sync-dlq",
        "max_retries": 3,
        "max_batch_size": 10
      }
    ]
  },

  // Durable Object giữ token-bucket rate limit + circuit breaker theo tenant/MST
  // (ADR-0001 §5). U9: tối thiểu đủ "không gọi dồn dập". U12: ngưỡng TINH CHỈNH qua
  // vars (resolveLimiterConfig) + log quan sát khi chặn (limiterEvent).
  "durable_objects": {
    "bindings": [
      { "name": "TENANT_LIMITER", "class_name": "TenantLimiter" },
      // GIÁM SÁT (mục C): singleton giữ health-state probe egress (id cố định "egress").
      { "name": "EGRESS_HEALTH", "class_name": "EgressHealth" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TenantLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["EgressHealth"] }
  ],

  // U12 — Ngưỡng rate-limit client (tinh chỉnh theo môi trường; bỏ trống → mặc định
  // trong rateLimiter.ts). Đây là cấu hình KHÔNG nhạy cảm nên đặt ở vars, không secret.
  "vars": {
    "LIMITER_CAPACITY": "10",
    "LIMITER_REFILL_PER_SEC": "2",
    "LIMITER_FAILURE_THRESHOLD": "5",
    "LIMITER_COOLDOWN_MS": "60000",
    // H-B.4 — fan-out: giãn khởi động tenant trên ~5' (jitter) + trần 10 lần reenqueue
    // liên tiếp rồi rơi về dead-letter (chặn vòng lặp vô hạn khi kẹt lâu). Bỏ trống →
    // mặc định fanout.ts.
    "FANOUT_JITTER_SPREAD_SEC": "300",
    // SỰ CỐ 2026-07-18 — nâng 60 → 300: cửa sổ phạt 429 của GDT quan sát được kéo dài
    // NHIỀU GIỜ (lan_dong_bo: 05:29→09:10Z toàn 429), trong khi hoãn 60s làm mỗi job
    // đập lại GDT mỗi phút — mỗi lần đập là CẢ chuỗi phân trang normal chạy lại từ đầu
    // (429 thường rơi ở nhánh sco cuối chuỗi) → tự nuôi cửa sổ phạt. 300s × trần 10 =
    // ~50' kiên nhẫn trước khi rơi về đường max_retries. Đánh đổi: khi GDT hồi sớm,
    // job chờ tối đa 5' mới thử lại — chấp nhận (tôn trọng máy chủ thuế > tốc độ).
    "FANOUT_BACKPRESSURE_DELAY_SEC": "300",
    "FANOUT_MAX_BACKPRESSURE": "10",
    // U25 AC3 (đóng drift 2026-07-18): giãn nhịp giữa hai request GDT trong một job
    // header + backoff 429 khi thiếu Retry-After. Mặc định trong syncRetryConfig.ts;
    // "0" = tắt tường minh. CHƯA KIỂM CHỨNG ngưỡng thật của GDT — chỉnh khi có số đo.
    "SYNC_PAGE_MIN_INTERVAL_MS": "500",
    "SYNC_RETRY_BACKOFF_MS": "3000",
    // Task 6 (delta-sync) — số TRANG tối đa mỗi lô `syncChunk`: một lần gọi Worker chỉ
    // kéo ≤ chừng này trang rồi tự enqueue message nối tiếp, thay vì phân trang cả kỳ
    // trong MỘT invocation (gốc rễ "Too many subrequests by single Worker invocation",
    // sự cố 2026-07-18). Bỏ trống → mặc định deps.ts (40). Hạ xuống nếu log
    // `[delta] local_limit` tái diễn.
    "DELTA_CHUNK_PAGES": "40"
  }

  // JWT_SECRET / bí mật egress nạp qua `wrangler secret put` — security.md.
  // Chuỗi kết nối Postgres dev đặt trong .dev.vars (KHÔNG commit) — xem .dev.vars.example.
}
