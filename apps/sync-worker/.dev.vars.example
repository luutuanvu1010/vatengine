# Biến môi trường local cho `wrangler dev` (KHÔNG commit .dev.vars thật — xem security.md).
# Copy file này thành .dev.vars rồi điền giá trị.

ENVIRONMENT="dev"

# U9 — Postgres qua Hyperdrive. Chuỗi kết nối local cho `wrangler dev` (Hyperdrive
# dùng biến này thay cho kết nối thật khi chạy local). CHỈ local, không commit:
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://user:pass@localhost:5432/vat"
