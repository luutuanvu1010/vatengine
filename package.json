{
  "name": "vatcrawlbot",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS truy xuất hóa đơn điện tử GDT — ngăn xếp Cloudflare/TypeScript (ADR-0001).",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:contract": "npm run test:contract --workspaces --if-present",
    "dev": "npm run dev -w apps/api"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@vitest/coverage-v8": "~3.2.0",
    "typescript": "^5.9.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
